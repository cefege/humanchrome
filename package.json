{
  "name": "humanchrome-monorepo",
  "version": "1.1.1",
  "private": true,
  "author": "Mihai Mateias",
  "license": "MIT",
  "description": "AI controls your real Chrome. Built for hard-to-automate platforms (LinkedIn, WhatsApp, Tinder, Facebook, Instagram). MCP and plain HTTP.",
  "homepage": "https://github.com/cefege/humanchrome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cefege/humanchrome.git"
  },
  "bugs": {
    "url": "https://github.com/cefege/humanchrome/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter humanchrome-shared build",
    "build:native": "pnpm --filter humanchrome-bridge build",
    "build:extension": "pnpm --filter humanchrome-extension build",
    "build:wasm": "pnpm --filter @humanchrome/wasm-simd build && pnpm run copy:wasm",
    "e2e:matrix": "node scripts/run-e2e-matrix.mjs",
    "e2e:full": "node scripts/run-e2e-matrix.mjs --build --json /tmp/e2e-result.json",
    "e2e:isolated": "node scripts/run-e2e-matrix.mjs --build --launch-chrome --json /tmp/e2e-result.json",
    "e2e:tasks": "node scripts/run-task-scenarios.mjs",
    "e2e:tasks:live": "node scripts/run-task-scenarios.mjs --live",
    "e2e:tasks:agent": "node scripts/run-agent-scenarios.mjs",
    "build": "pnpm -r --filter='!@humanchrome/wasm-simd' build",
    "copy:wasm": "cp ./packages/wasm-simd/pkg/simd_math.js ./packages/wasm-simd/pkg/simd_math_bg.wasm ./app/chrome-extension/workers/",
    "dev:shared": "pnpm --filter humanchrome-shared dev",
    "dev:native": "pnpm --filter humanchrome-bridge dev",
    "dev:extension": "pnpm --filter humanchrome-extension dev",
    "dev": "pnpm --filter humanchrome-shared build && pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "clean:dist": "pnpm -r exec rm -rf dist .turbo",
    "clean:modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean": "pnpm clean:dist && pnpm clean:modules",
    "//typecheck": "Two filters: wasm-simd (Rust pkg, no tsconfig) AND humanchrome-monorepo (the workspace root, no tsconfig either — pnpm -r exec includes it).",
    "typecheck": "pnpm -r --filter='!@humanchrome/wasm-simd' --filter='!humanchrome-monorepo' exec tsc --noEmit",
    "//test": "Serial workspace execution (--workspace-concurrency=1) — running native-server jest and chrome-extension vitest in parallel causes CPU/memory contention that times out otherwise-passing tests. Serial is ~150s vs parallel ~485s here, AND green vs flaky-failures. See IMP-0123.",
    "test": "pnpm -r --workspace-concurrency=1 --filter='!@humanchrome/wasm-simd' --filter='!humanchrome-monorepo' test",
    "doctor": "node scripts/claude-doctor.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,html,css}": [
      "prettier --write"
    ],
    "packages/shared/src/tools.ts": "node .claude/scripts/regen-tools-doc.mjs",
    "packages/shared/src/tool-schemas/*.ts": "node .claude/scripts/regen-tools-doc.mjs"
  },
  "pnpm": {
    "overrides": {
      "hono@<4.12.25": ">=4.12.25",
      "tmp@<0.2.6": ">=0.2.6",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "shell-quote@<1.8.2": ">=1.8.2",
      "esbuild@<0.28.1": ">=0.28.1",
      "protobufjs@<=7.6.2": ">=7.6.3",
      "form-data@>=4.0.0 <4.0.6": ">=4.0.6",
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16",
      "js-yaml@<=4.1.1": ">=4.2.0",
      "@babel/core@<=7.29.0": ">=7.29.6"
    }
  }
}
