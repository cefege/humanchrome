{
  "name": "humanchrome-monorepo",
  "version": "1.2.0",
  "private": true,
  "author": "Mihai Mateias",
  "license": "MIT",
  "description": "A native Chrome fleet for AI agents. Persistent signed-in profiles, parallel browsers, and remote control over MCP or HTTP.",
  "homepage": "https://github.com/cefege/humanchrome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cefege/humanchrome.git"
  },
  "bugs": {
    "url": "https://github.com/cefege/humanchrome/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:contracts": "node packages/shared/scripts/export-rust-contract.mjs",
    "build:native": "cargo build --locked --release -p humanchrome-native --bins",
    "build:wasm": "pnpm --filter @humanchrome/wasm-simd build && pnpm run copy:wasm",
    "build:shared": "pnpm --filter humanchrome-shared build",
    "build:browser": "pnpm run build:wasm && pnpm run build:shared && node scripts/build-browser-workers.mjs && pnpm --filter humanchrome-extension build",
    "build:extension": "pnpm run build:contracts && pnpm run build:native && pnpm run build:browser",
    "build": "pnpm run build:extension",
    "package:native": "node scripts/package-native-release.mjs",
    "smoke:native-release": "node scripts/smoke-native-release.mjs",
    "e2e:matrix": "node scripts/run-e2e-matrix.mjs",
    "e2e:full": "node scripts/run-e2e-matrix.mjs --build --json /tmp/e2e-result.json",
    "e2e:isolated": "node scripts/run-e2e-matrix.mjs --build --launch-chrome --json /tmp/e2e-result.json",
    "e2e:tasks": "node scripts/run-task-scenarios.mjs",
    "e2e:tasks:live": "node scripts/run-task-scenarios.mjs --live",
    "e2e:tasks:agent": "node scripts/run-agent-scenarios.mjs",
    "copy:wasm": "node scripts/copy-wasm-simd.mjs",
    "dev:shared": "pnpm --filter humanchrome-shared dev",
    "dev:native": "cargo run --locked -p humanchrome-native --bin humanchrome-nativehost",
    "dev:extension": "pnpm --filter humanchrome-extension dev",
    "dev": "pnpm --filter humanchrome-shared build && pnpm --filter humanchrome-extension dev",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "clean:dist": "pnpm -r exec rm -rf dist .turbo",
    "clean:modules": "pnpm -r exec rm -rf node_modules && rm -rf node_modules",
    "clean": "pnpm clean:dist && pnpm clean:modules",
    "//typecheck": "Exclude Rust-only, dependency-only optional engines, adapter-only build inputs, and the root workspace: these packages have no TypeScript project.",
    "typecheck": "pnpm -r --filter='!@humanchrome/wasm-simd' --filter='!@humanchrome/optional-engines' --filter='!@humanchrome/third-party-adapters' --filter='!humanchrome-monorepo' exec tsc --noEmit",
    "//test": "Shared and extension JavaScript tests run before Cargo-owned native runtime tests.",
    "test": "pnpm --filter humanchrome-shared test && pnpm --filter humanchrome-extension test && cargo test --locked --workspace",
    "doctor": "node scripts/claude-doctor.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yaml,html,css}": [
      "prettier --write"
    ],
    "packages/shared/src/tools.ts": "node .claude/scripts/regen-tools-doc.mjs",
    "packages/shared/src/tool-schemas/*.ts": "node .claude/scripts/regen-tools-doc.mjs"
  }
}
