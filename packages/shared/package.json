{
  "name": "humanchrome-shared",
  "version": "1.1.1",
  "private": true,
  "description": "Shared types and constants for HumanChrome.",
  "author": "Mihai Mateias",
  "license": "MIT",
  "homepage": "https://github.com/cefege/humanchrome",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cefege/humanchrome.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/cefege/humanchrome/issues"
  },
  "main": "dist/index.js",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "npx eslint 'src/**/*.{js,ts}'",
    "lint:fix": "npx eslint 'src/**/*.{js,ts}' --fix",
    "format": "prettier --write 'src/**/*.{js,ts,json}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "regen:tool-index-snapshot": "node scripts/regen-tool-index-snapshot.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@typescript-eslint/parser": "^8.60.1",
    "tsup": "^8.5.1",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  }
}
