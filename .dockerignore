# The coordinator build needs only Rust sources and its generated shared contract.
**
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!crates
!crates/**
!packages
!packages/wasm-simd
!packages/wasm-simd/Cargo.toml
!packages/wasm-simd/src
!packages/wasm-simd/src/**
!packages/shared
!packages/shared/generated
!packages/shared/generated/rust-contract.json

**/target
**/.env
**/.env.*
