# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
FROM --platform=$BUILDPLATFORM rust:1.99.1-bookworm@sha256:9181b56c2a21ab1d5e73cffe04fc762426d30aa7fac3c91141dd033f49a7fc8b AS build
ARG TARGETARCH
ENV RUSTUP_TOOLCHAIN=1.99.1 \
    CARGO_BUILD_JOBS=2 \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar

RUN test "$TARGETARCH" = amd64 \
 && apt-get update \
 && apt-get install --yes --no-install-recommends build-essential perl pkg-config \
 && if [ "$(dpkg --print-architecture)" != amd64 ]; then \
      apt-get install --yes --no-install-recommends gcc-x86-64-linux-gnu g++-x86-64-linux-gnu; \
    fi \
 && rustup target add --toolchain 1.99.1 x86_64-unknown-linux-gnu \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates crates
COPY packages/wasm-simd/Cargo.toml packages/wasm-simd/Cargo.toml
COPY packages/wasm-simd/src packages/wasm-simd/src
COPY packages/shared/generated/rust-contract.json packages/shared/generated/rust-contract.json

RUN cargo build --locked --release --target x86_64-unknown-linux-gnu -p humanchrome-native --bin humanchrome-bridge

FROM debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3 AS runtime

RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 humanchrome \
 && useradd --uid 1000 --gid humanchrome --create-home --shell /usr/sbin/nologin humanchrome

WORKDIR /app

COPY --from=build --chown=humanchrome:humanchrome /workspace/target/x86_64-unknown-linux-gnu/release/humanchrome-bridge /usr/local/bin/humanchrome-bridge

USER humanchrome
EXPOSE 12301

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 CMD ["curl", "--fail", "--silent", "--show-error", "http://127.0.0.1:12301/healthz"]

ENTRYPOINT ["humanchrome-bridge"]
CMD ["fleet", "coordinator", "--config", "/etc/humanchrome/coordinator.json"]
